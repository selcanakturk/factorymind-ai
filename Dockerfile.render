# syntax=docker/dockerfile:1

# Render requires prebuilt images to target linux/amd64. Pin the verified Python
# runtime so serialized model compatibility does not depend on provider defaults.
FROM --platform=linux/amd64 python:3.13.2-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements-runtime.txt ./requirements-runtime.txt
RUN python -m pip install --no-cache-dir -r requirements-runtime.txt

COPY backend/__init__.py ./backend/__init__.py
COPY backend/app ./backend/app
COPY src ./src
COPY scripts/prepare_artifacts.py ./scripts/prepare_artifacts.py

# List every required runtime artifact explicitly. A public-clone build fails
# here until the two private visual artifacts are supplied to the local context.
COPY models/artifact_manifest.json ./models/artifact_manifest.json
COPY models/factorymind_failure_model_v1.joblib ./models/factorymind_failure_model_v1.joblib
COPY models/factorymind_failure_model_v1.metadata.json ./models/factorymind_failure_model_v1.metadata.json
COPY models/factorymind_failure_risk_thresholds_v1.json ./models/factorymind_failure_risk_thresholds_v1.json
COPY models/factorymind_rul_model_v1.joblib ./models/factorymind_rul_model_v1.joblib
COPY models/factorymind_rul_model_v1.metadata.json ./models/factorymind_rul_model_v1.metadata.json
COPY models/factorymind_anomaly_model_v1.joblib ./models/factorymind_anomaly_model_v1.joblib
COPY models/factorymind_anomaly_model_v1.metadata.json ./models/factorymind_anomaly_model_v1.metadata.json
COPY models/factorymind_visual_quality_model_v1.joblib ./models/factorymind_visual_quality_model_v1.joblib
COPY models/factorymind_visual_quality_model_v1.metadata.json ./models/factorymind_visual_quality_model_v1.metadata.json

# Enforce manifest checks and the same strict compatibility loader used at API startup.
RUN python scripts/prepare_artifacts.py

RUN useradd --create-home --uid 10001 factorymind
USER factorymind

EXPOSE 10000

CMD ["sh", "-c", "exec uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
